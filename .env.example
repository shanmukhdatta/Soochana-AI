# ==============================================================================
# RiskPulse AI — Environment Configuration Template
# Copy this file to .env before starting the backend server:
#   cp .env.example .env
# Never commit active API keys, secrets, or tokens to version control.
# ==============================================================================

# --- Model Loading & Inference Directories ---
EVENT_MODEL_DIR=./models/event_classifier
SENTIMENT_MODEL_DIR=./models/sentiment_regressor
IMPACT_MODEL_DIR=./models/impact_engine
CONFIG_DIR=./configs
MODEL_DEVICE=cpu
NLP_MAX_LENGTH=128
MAX_BATCH_SIZE=20

# Set to true ONLY for portfolio-only/UI inspection without loading trained NLP weights.\n# /analyze and /health then return HTTP 503; no mock inference is produced.
SKIP_MODEL_LOAD=false

# --- Market Data Configuration ---
# Options: 'yfinance' (live Yahoo Finance quotes) or 'csv' (offline reproducible directory)
PRICE_PROVIDER=yfinance
# PRICE_CSV_DIR=./data/daily_adjusted_prices

# --- Ingestion Pipeline Configuration (Optional for Live Polling) ---
# When omitted, the system reads from pre-collected signals in data/ingestion/riskpulse.db
MARKETAUX_API_TOKEN=your_marketaux_api_token_here
INGESTION_ADMIN_TOKEN=your_random_admin_secret_here
INGESTION_DB_PATH=data/ingestion/riskpulse.db

# --- Bujji AI Financial Assistant (Optional Groq Integration) ---
# Free-tier Groq API key for conversational explanations
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# --- Optional HuggingFace Downloader Configuration ---
# Used only if fetching weights from private/custom user repos via scripts/fetch_models.py
# EVENT_MODEL_REPO=your-user/your-event-model
# SENTIMENT_MODEL_REPO=your-user/your-sentiment-model
# IMPACT_MODEL_REPO=your-user/your-impact-model
# HF_TOKEN=your_huggingface_token_here
